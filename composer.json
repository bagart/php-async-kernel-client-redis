{
    "name": "bagart/ask-client-redis",
    "description": "Fully asynchronous Redis client library built on top of BAGArt/AsyncKernel. Fiber-based, promise-driven, transport-agnostic inside ASK ecosystem.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "ASK",
        "async",
        "redis",
        "fiber",
        "promise",
        "pipeline",
        "pubsub",
        "non-blocking",
        "transport"
    ],
    "authors": [
        {
            "name": "BAGArt (Artur Baltaev)",
            "email": "baltaev.artur+ask@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-redis": "*",
        "bagart/async-kernel": "*",
        "bagart/ask-client": "*"
    },
    "require-dev": {
        "bagart/telegram-platform-devops-baseline": "@dev",
        "phpstan/phpstan": "^1.11",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "BAGArt\\ASKClientRedis\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BAGArt\\ASKClientRedis\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "scripts": {
        "test": "composer exec pest",
        "analyse": "phpstan analyse src --level=max"
    },
    "repositories": {
        "php-async-kernel-lib": {
            "type": "path",
            "url": "../php-async-kernel-lib"
        },
        "php-async-kernel-client": {
            "type": "path",
            "url": "../php-async-kernel-client"
        },
        "baseline": {
            "type": "path",
            "url": "../telegram-platform-devops-baseline"
        }
    }
}
